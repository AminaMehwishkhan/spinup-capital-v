# --- Alpaca (paper trading) ---
# Leave blank to run in MOCK mode (fully simulated fills, no network calls).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# 'indicative' (free, every account) or 'opra' (needs an options data subscription)
ALPACA_OPTIONS_FEED=indicative

# --- LLM (used for thesis generation / bull-bear debate / autopsy) ---
# Leave both blank to run in HEURISTIC mode (deterministic rule-based text,
# no network calls, no cost — good for offline dev / CI demos).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=heuristic   # one of: heuristic | openai | anthropic

# --- Firm settings ---
STARTING_TREASURY=100000
DATABASE_URL=sqlite:///./spinup.db
